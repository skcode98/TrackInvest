#!/bin/sh
# Auto-bump version.js and sw.js before every commit
VERSION_FILE="version.js"
SW_FILE="sw.js"

# Bump version.js — format: const APP_VERSION = 'v5.30';
if [ -f "$VERSION_FILE" ]; then
    CURRENT=$(sed -n "s/^const APP_VERSION = 'v\([0-9]*\.[0-9]*\)';/\1/p" "$VERSION_FILE")
    if [ -n "$CURRENT" ]; then
        MAJOR=$(echo "$CURRENT" | cut -d. -f1)
        MINOR=$(echo "$CURRENT" | cut -d. -f2)
        NEW_MINOR=$((MINOR + 1))
        sed -i "s/^const APP_VERSION = 'v$CURRENT';/const APP_VERSION = 'v$MAJOR.$NEW_MINOR';/" "$VERSION_FILE"
        git add "$VERSION_FILE"
        echo "✓ version.js bumped: v$CURRENT → v$MAJOR.$NEW_MINOR"
    fi
fi

# Bump sw.js — format: const SW_BUILD = 30;
if [ -f "$SW_FILE" ]; then
    CURRENT_BUILD=$(sed -n "s/^const SW_BUILD = \([0-9]*\);.*/\1/p" "$SW_FILE")
    if [ -n "$CURRENT_BUILD" ]; then
        NEW_BUILD=$((CURRENT_BUILD + 1))
        sed -i "s/^const SW_BUILD = $CURRENT_BUILD;/const SW_BUILD = $NEW_BUILD;/" "$SW_FILE"
        git add "$SW_FILE"
        echo "✓ sw.js bumped: $CURRENT_BUILD → $NEW_BUILD"
    fi
fi
